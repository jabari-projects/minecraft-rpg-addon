{
  "format_version": "1.10.0",
  "animation_controllers": {
    "controller.animation.minecraft_world_rpg.shadow_wolf.move": {
      "initial_state": "idle",
      "states": {
        "idle": {
          "animations": [
            "idle"
          ],
          "transitions": [
            {
              "run": "query.modified_move_speed > 0.55"
            },
            {
              "walk": "query.modified_move_speed > 0.05"
            }
          ]
        },
        "walk": {
          "animations": [
            "walk"
          ],
          "transitions": [
            {
              "run": "query.modified_move_speed > 0.55"
            },
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ]
        },
        "run": {
          "animations": [
            "run"
          ],
          "transitions": [
            {
              "walk": "query.modified_move_speed <= 0.55 && query.modified_move_speed > 0.05"
            },
            {
              "idle": "query.modified_move_speed <= 0.05"
            }
          ]
        }
      }
    }
  }
}
